# Backend Environment Variables
# Copy this file to .env and fill in the values, or set as environment variables

# Database (not needed for dev profile - uses H2)
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# JWT Secret (change in production!)
JWT_SECRET=your-256-bit-secret-key-change-in-production-must-be-long-enough

# AWS S3 (not needed for dev profile - uses local storage)
AWS_S3_BUCKET=wedding-photography-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key

# Email via SMTP (not needed for dev profile - uses console output)
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords)
# For SendGrid: use MAIL_HOST=smtp.sendgrid.net, MAIL_PORT=587, MAIL_USERNAME=apikey, MAIL_PASSWORD=<sendgrid-api-key>
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@yourdomain.com

# Twilio (for SMS and WhatsApp OTP)
# Sign up at https://www.twilio.com and get your credentials from the Console Dashboard
# TWILIO_ACCOUNT_SID:  Account SID from https://console.twilio.com
# TWILIO_AUTH_TOKEN:   Auth Token from https://console.twilio.com
# TWILIO_PHONE_NUMBER: A Twilio phone number in E.164 format (e.g. +15551234567)
#                      obtained from https://console.twilio.com/us1/develop/phone-numbers/manage/incoming
# TWILIO_WHATSAPP_NUMBER: Twilio WhatsApp sender (sandbox: whatsapp:+14155238886)
#                      For production use a Twilio-approved WhatsApp Business number
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# App URLs
APP_BASE_URL=http://localhost:8080
APP_GALLERY_URL=http://localhost:5173/gallery

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
